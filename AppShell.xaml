<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:HabitDaily.Views"
       xmlns:constants="clr-namespace:HabitDaily.Constants"
       x:Class="HabitDaily.AppShell"
       BackgroundColor="{StaticResource BackgroundDark}"
       ForegroundColor="{StaticResource PrimaryGreen}"
       TitleColor="{StaticResource TextWhite}"
>
    
    <!-- Barre de navigation inferieure -->
    <TabBar>

        <!-- Onglet1 Accueil: Tableau de bord -->
        <Tab Title="Accueil">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static constants:IconFont.Home}"
                                 FontFamily="MaterialIcons"
                                 Color="{StaticResource PrimaryGreen}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>

        <!-- Onglet2 Calendrier -->
        <Tab Title="Cal">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static constants:IconFont.Calendar}"
                                 FontFamily="MaterialIcons"
                                 Color="{StaticResource PrimaryGreen}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:CalendarPage}" />
        </Tab>

        <!-- Onglet3 Statistiques -->
        <Tab Title="Stats">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static constants:IconFont.Stats}"
                                 FontFamily="MaterialIcons"
                                 Color="{StaticResource PrimaryGreen}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:StatsPage}" />
        </Tab>

        <!-- Onglet4 Profile -->
        <Tab Title="Profile">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static constants:IconFont.Profile}"
                                 FontFamily="MaterialIcons"
                                 Color="{StaticResource PrimaryGreen}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>

    </TabBar>
    
</Shell>