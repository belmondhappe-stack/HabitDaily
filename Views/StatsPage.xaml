<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:constants="clr-namespace:HabitDaily.Constants"
             xmlns:viewModels="clr-namespace:HabitDaily.ViewModels"
             x:Class="HabitDaily.Views.StatsPage"
             x:DataType="viewModels:StatsViewModel"
             Title="Stats"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ScrollView>
        <VerticalStackLayout Padding="18,16,18,28"
                             Spacing="18"
                             HorizontalOptions="Center"
                             MaximumWidthRequest="560">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Progression &amp; Séries"
                           TextColor="{StaticResource TextWhite}"
                           FontSize="22"
                           FontAttributes="Bold" />
                    <Label Text="Vos gestes ont un impact, jour après jour."
                           TextColor="{StaticResource TextGray}"
                           FontSize="12" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="{x:Static constants:IconFont.Notifications}"
                        FontFamily="MaterialIcons"
                        FontSize="20"
                        TextColor="{StaticResource TextWhite}"
                        BackgroundColor="{StaticResource CardRaised}"
                        BorderColor="{StaticResource BorderColor}"
                        BorderWidth="1"
                        CornerRadius="22"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        Clicked="OnNotificationsClicked"
                        SemanticProperties.Description="Notifications" />
            </Grid>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">
                <Border BackgroundColor="{StaticResource CardRaised}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeShape="RoundRectangle 20"
                        Padding="14">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="{x:Static constants:IconFont.Check}"
                               FontFamily="MaterialIcons"
                               FontSize="22"
                               TextColor="{StaticResource PrimaryGreen}" />
                        <Label Text="{Binding MonthProgressLabel}"
                               TextColor="{StaticResource TextWhite}"
                               FontSize="24"
                               FontAttributes="Bold" />
                        <Label Text="Jours actifs · ce mois"
                               TextColor="{StaticResource TextGray}"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource CardRaised}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeShape="RoundRectangle 20"
                        Padding="14">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="{x:Static constants:IconFont.Fire}"
                               FontFamily="MaterialIcons"
                               FontSize="22"
                               TextColor="{StaticResource SecondaryBlue}" />
                        <Label Text="{Binding CurrentStreak, StringFormat='{0} j'}"
                               TextColor="{StaticResource TextWhite}"
                               FontSize="24"
                               FontAttributes="Bold" />
                        <Label Text="Série actuelle"
                               TextColor="{StaticResource TextGray}"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeShape="RoundRectangle 22"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Évolution"
                                   TextColor="{StaticResource TextWhite}"
                                   FontSize="17"
                                   FontAttributes="Bold" />
                            <Label Text="Écogestes validés · 8 dernières semaines"
                                   TextColor="{StaticResource TextGray}"
                                   FontSize="11" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#193D2D"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="9,5"
                                VerticalOptions="Center">
                            <Label Text="{Binding CompletedActions, StringFormat='{0} · 30 j'}"
                                   TextColor="{StaticResource PrimaryGreen}"
                                   FontSize="11"
                                   FontAttributes="Bold" />
                        </Border>
                    </Grid>
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding WeeklyActivity}"
                                           HorizontalOptions="Center"
                                           Spacing="0"
                                           HeightRequest="116">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:WeeklyActivity">
                                <VerticalStackLayout WidthRequest="30"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="End"
                                                     Spacing="5">
                                    <Label Text="{Binding CompletedCount}"
                                           TextColor="{StaticResource TextGray}"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center" />
                                    <Grid HeightRequest="68"
                                          WidthRequest="18"
                                          VerticalOptions="End">
                                        <Border HeightRequest="{Binding BarHeight}"
                                                BackgroundColor="{StaticResource PrimaryGreen}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                VerticalOptions="End" />
                                    </Grid>
                                    <Label Text="{Binding DayLabel}"
                                           TextColor="{StaticResource TextGray}"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource CardRaised}"
                    Stroke="{StaticResource PrimaryGreen}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Taux de réussite"
                                   TextColor="{StaticResource TextWhite}"
                                   FontSize="16"
                                   FontAttributes="Bold" />
                            <Label Text="Sur les 30 derniers jours"
                                   TextColor="{StaticResource TextGray}"
                                   FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding SuccessRateLabel}"
                               TextColor="{StaticResource SecondaryBlue}"
                               FontSize="24"
                               FontAttributes="Bold"
                               VerticalTextAlignment="Center" />
                    </Grid>
                    <ProgressBar Progress="{Binding SuccessProgress}"
                                 ProgressColor="{StaticResource PrimaryGreen}"
                                 BackgroundColor="{StaticResource BorderColor}"
                                 HeightRequest="8" />
                    <Label Text="{Binding RecentActivityLabel}"
                           TextColor="{StaticResource TextGray}"
                           FontSize="11" />
                    <Label IsVisible="{Binding HasNoHabits}"
                           Text="Ajoutez une habitude pour commencer à suivre votre progression."
                           TextColor="{StaticResource TextGray}"
                           FontSize="11" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">
                <Border BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{x:Static constants:IconFont.EnergySavingsLeaf}"
                               FontFamily="MaterialIcons"
                               FontSize="20"
                               TextColor="{StaticResource PrimaryGreen}" />
                        <Label Text="{Binding TotalCo2Saved, StringFormat='{0:F2} kg'}"
                               TextColor="{StaticResource TextWhite}"
                               FontSize="19"
                               FontAttributes="Bold" />
                        <Label Text="CO₂ économisé au total"
                               TextColor="{StaticResource TextGray}"
                               FontSize="11" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{x:Static constants:IconFont.Leaf}"
                               FontFamily="MaterialIcons"
                               FontSize="20"
                               TextColor="{StaticResource SecondaryBlue}" />
                        <Label Text="{Binding HabitCount}"
                               TextColor="{StaticResource TextWhite}"
                               FontSize="19"
                               FontAttributes="Bold" />
                        <Label Text="Habitudes actives"
                               TextColor="{StaticResource TextGray}"
                               FontSize="11" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeShape="RoundRectangle 18"
                    Padding="14">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Votre meilleure série"
                               TextColor="{StaticResource TextWhite}"
                               FontSize="14"
                               FontAttributes="Bold" />
                        <Label Text="Continuez à faire grandir vos habitudes."
                               TextColor="{StaticResource TextGray}"
                               FontSize="11" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="{Binding BestStreak, StringFormat='{0} jours'}"
                           TextColor="{StaticResource SecondaryBlue}"
                           FontSize="17"
                           FontAttributes="Bold"
                           VerticalTextAlignment="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
