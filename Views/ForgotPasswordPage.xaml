<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:constants="clr-namespace:HabitDaily.Constants"
             x:Class="HabitDaily.Views.ForgotPasswordPage"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Mot de passe oublié">

    <Grid>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
            <Label Text="{x:Static constants:IconFont.LockReset}"
                   FontFamily="MaterialIcons"
                   TextColor="{StaticResource PrimaryGreen}"
                   FontSize="48"
                   HorizontalTextAlignment="Center" />

            <Label Text="Mot de passe oublié ?"
                   TextColor="{StaticResource PrimaryGreen}"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Border BackgroundColor="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="{x:Static constants:IconFont.Mail}"
                           FontFamily="MaterialIcons"
                           TextColor="{StaticResource SecondaryBlue}"
                           FontSize="24"
                           VerticalOptions="Center" />
                    <Label Text="La récupération par e-mail n’est pas encore disponible. Aucun e-mail ne peut être envoyé pour le moment. Veuillez contacter l’administrateur de l’application pour obtenir de l’aide."
                           TextColor="{StaticResource TextWhite}"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           HorizontalOptions="FillAndExpand" />
                </HorizontalStackLayout>
            </Border>

            <Button Text="Retour à la connexion"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource SecondaryBlue}"
                    Command="{Binding GoBackCommand}">
                <Button.ImageSource>
                    <FontImageSource Glyph="{x:Static constants:IconFont.ArrowBack}"
                                     FontFamily="MaterialIcons"
                                     Color="{StaticResource SecondaryBlue}" />
                </Button.ImageSource>
            </Button>
        </VerticalStackLayout>
    </Grid>
</ContentPage>