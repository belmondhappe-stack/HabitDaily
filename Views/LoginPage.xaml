<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:constants="clr-namespace:HabitDaily.Constants"
             x:Class="HabitDaily.Views.LoginPage"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Connexion">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

            <!-- En-tête / Logo textuel -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="{x:Static constants:IconFont.Leaf}"
                       FontFamily="MaterialIcons"
                       TextColor="{StaticResource PrimaryGreen}"
                       FontSize="32"
                       VerticalOptions="Center" />
                <Label Text="HabitDaily" 
                       TextColor="{StaticResource PrimaryGreen}" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Cultivez vos bonnes habitudes au quotidien" 
                       TextColor="{StaticResource TextMuted}" 
                       FontSize="14" 
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Formulaire de Connexion -->
            <VerticalStackLayout Spacing="15" Margin="0,20,0,0">
                
                <!-- Champ Email -->
                <Border BackgroundColor="{StaticResource CardBackground}" 
                        Stroke="{StaticResource BorderColor}" 
                        StrokeShape="RoundRectangle 12" Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="{x:Static constants:IconFont.Email}"
                               FontFamily="MaterialIcons"
                               TextColor="{StaticResource TextMuted}"
                               FontSize="20"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Placeholder="Adresse email"
                               PlaceholderColor="{StaticResource TextMuted}"
                               TextColor="{StaticResource TextWhite}"
                               Text="{Binding Email}"
                               Keyboard="Email" />
                    </Grid>
                </Border>

                <!-- Champ Mot de passe -->
                <Border BackgroundColor="{StaticResource CardBackground}" 
                        Stroke="{StaticResource BorderColor}" 
                        StrokeShape="RoundRectangle 12" Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="{x:Static constants:IconFont.Lock}"
                               FontFamily="MaterialIcons"
                               TextColor="{StaticResource TextMuted}"
                               FontSize="20"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Placeholder="Mot de passe"
                               PlaceholderColor="{StaticResource TextMuted}"
                               TextColor="{StaticResource TextWhite}"
                               Text="{Binding Password}"
                               IsPassword="True" />
                    </Grid>
                </Border>

                <Button Text="Mot de passe oublié ?" 
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextMuted}"
                        FontSize="12"
                        HorizontalOptions="End"
                        Command="{Binding GoToForgotPasswordCommand}"
                        Padding="0"
                        Margin="0,-5,5,0">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static constants:IconFont.LockReset}"
                                         FontFamily="MaterialIcons"
                                         Color="{StaticResource TextMuted}" />
                    </Button.ImageSource>
                </Button>

                <!-- Bouton de Connexion -->
                <Button Text="Se connecter" 
                        BackgroundColor="{StaticResource PrimaryGreen}"
                        TextColor="{StaticResource BackgroundDark}"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        Command="{Binding LoginCommand}"
                        Margin="0,5,0,0">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static constants:IconFont.Login}"
                                         FontFamily="MaterialIcons"
                                         Color="{StaticResource BackgroundDark}" />
                    </Button.ImageSource>
                </Button>

                <!-- Lien vers Inscription -->
                <Button Text="Créer un compte" 
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource SecondaryBlue}"
                        Command="{Binding GoToSignupCommand}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static constants:IconFont.PersonAdd}"
                                         FontFamily="MaterialIcons"
                                         Color="{StaticResource SecondaryBlue}" />
                    </Button.ImageSource>
                </Button>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>