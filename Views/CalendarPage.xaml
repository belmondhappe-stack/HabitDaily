<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:constants="clr-namespace:HabitDaily.Constants"
             xmlns:models="clr-namespace:HabitDaily.Models"
             xmlns:viewModels="clr-namespace:HabitDaily.ViewModels"
             x:Class="HabitDaily.Views.CalendarPage"
             x:DataType="viewModels:CalendarViewModel"
             Title="Calendrier"
             BackgroundColor="{StaticResource BackgroundDark}">

    <RefreshView IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                 Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16,14,16,26"
                                 Spacing="16"
                                 HorizontalOptions="Fill"
                                 MaximumWidthRequest="520">
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="8">
                    <Label Text="Calendrier"
                           TextColor="{StaticResource TextWhite}"
                           FontSize="23"
                           FontAttributes="Bold"
                           VerticalTextAlignment="Center" />
                    <Button Grid.Column="1"
                            Text="{x:Static constants:IconFont.Notifications}"
                            FontFamily="MaterialIcons"
                            FontSize="20"
                            TextColor="{StaticResource TextWhite}"
                            BackgroundColor="{StaticResource CardRaised}"
                            BorderColor="{StaticResource BorderColor}"
                            BorderWidth="1"
                            CornerRadius="22"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="0"
                            Clicked="OnNotificationsClicked"
                            SemanticProperties.Description="Notifications" />
                    <Button Grid.Column="2"
                            Text="Aujourd’hui"
                            TextColor="{StaticResource PrimaryGreen}"
                            BackgroundColor="{StaticResource CardBackground}"
                            BorderColor="{StaticResource BorderColor}"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            Padding="12,0"
                            HeightRequest="44"
                            Command="{Binding SelectTodayCommand}" />
                </Grid>

                <Border BackgroundColor="{StaticResource CardRaised}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeShape="RoundRectangle 24"
                        Padding="14,12"
                        HorizontalOptions="Fill"
                        MaximumWidthRequest="460">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10">
                            <Button Text="‹"
                                    FontSize="27"
                                    TextColor="{StaticResource TextGray}"
                                    BackgroundColor="Transparent"
                                    Padding="0"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    Command="{Binding PreviousMonthCommand}"
                                    SemanticProperties.Description="Mois précédent" />
                            <Label Grid.Column="1"
                                   Text="{Binding DisplayedMonthLabel}"
                                   TextColor="{StaticResource TextWhite}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center" />
                            <Button Grid.Column="2"
                                    Text="›"
                                    FontSize="27"
                                    TextColor="{StaticResource TextGray}"
                                    BackgroundColor="Transparent"
                                    Padding="0"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    Command="{Binding NextMonthCommand}"
                                    SemanticProperties.Description="Mois suivant" />
                        </Grid>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,*,*,*,*,*,*"
                              ColumnSpacing="2">
                            <Label Text="L" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" FontSize="12" />
                            <Label Grid.Column="1" Text="M" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" FontSize="12" />
                            <Label Grid.Column="2" Text="M" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" FontSize="12" />
                            <Label Grid.Column="3" Text="J" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" FontSize="12" />
                            <Label Grid.Column="4" Text="V" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" FontSize="12" />
                            <Label Grid.Column="5" Text="S" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" FontSize="12" />
                            <Label Grid.Column="6" Text="D" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" FontSize="12" />
                        </Grid>

                        <VerticalStackLayout Grid.Row="2"
                                             AutomationId="CalendarMonthGrid"
                                             BindableLayout.ItemsSource="{Binding CalendarWeeks}"
                                             Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CalendarWeek">
                                    <Grid ColumnDefinitions="*,*,*,*,*,*,*"
                                          ColumnSpacing="2"
                                          HeightRequest="36"
                                          HorizontalOptions="Fill"
                                          BindableLayout.ItemsSource="{Binding Days}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:CalendarDay">
                                                <Border Grid.Column="{Binding ColumnIndex}"
                                                        BackgroundColor="{Binding BackgroundColor}"
                                                        Stroke="{Binding StrokeColor}"
                                                        StrokeShape="Ellipse"
                                                        StrokeThickness="2"
                                                        WidthRequest="33"
                                                        HeightRequest="33"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"
                                                        SemanticProperties.Description="{Binding AccessibilityDescription}">
                                                    <Label Text="{Binding DayNumber}"
                                                           TextColor="{Binding TextColor}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center" />
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CalendarViewModel}}, Path=SelectDayCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">
                    <Border BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                            <Label Text="{x:Static constants:IconFont.Check}"
                                   FontFamily="MaterialIcons"
                                   FontSize="21"
                                   TextColor="{StaticResource PrimaryGreen}"
                                   VerticalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding CompletedCount, StringFormat='{0:00}'}"
                                       TextColor="{StaticResource TextWhite}"
                                       FontSize="21"
                                       FontAttributes="Bold" />
                                <Label Text="Actions validées"
                                       TextColor="{StaticResource TextGray}"
                                       FontSize="10" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                            <Label Text="{x:Static constants:IconFont.EnergySavingsLeaf}"
                                   FontFamily="MaterialIcons"
                                   FontSize="21"
                                   TextColor="{StaticResource PrimaryGreen}"
                                   VerticalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding DailyCo2Saved, StringFormat='{0:F2} kg'}"
                                       TextColor="{StaticResource TextWhite}"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label Text="CO₂ économisé"
                                       TextColor="{StaticResource TextGray}"
                                       FontSize="10" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Écogestes du jour"
                               TextColor="{StaticResource TextWhite}"
                               FontSize="17"
                               FontAttributes="Bold" />
                        <Label Text="{Binding SelectedDateLabel}"
                               TextColor="{StaticResource TextGray}"
                               FontSize="12" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="6"
                                           VerticalOptions="Center">
                        <Ellipse Fill="{StaticResource PrimaryGreen}" WidthRequest="9" HeightRequest="9" />
                        <Label Text="Validé"
                               TextColor="{StaticResource TextGray}"
                               FontSize="11"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DailyLogs}"
                                     Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:HabitLogDetails">
                            <Border BackgroundColor="{StaticResource CardBackground}"
                                    Stroke="{StaticResource BorderColor}"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="12">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="11">
                                    <Border WidthRequest="42"
                                            HeightRequest="42"
                                            BackgroundColor="{Binding IconColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                        <Label Text="{Binding IconGlyph}"
                                               FontFamily="MaterialIcons"
                                               TextColor="{StaticResource BackgroundDark}"
                                               FontSize="20"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="2">
                                        <Label Text="{Binding HabitTitle}"
                                               TextColor="{StaticResource TextWhite}"
                                               FontSize="14"
                                               FontAttributes="Bold" />
                                        <Label Text="Écogeste accompli"
                                               TextColor="{StaticResource TextGray}"
                                               FontSize="11" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{Binding Co2ReductionPerAction, StringFormat='-{0:F2} kg'}"
                                           TextColor="{StaticResource PrimaryGreen}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border IsVisible="{Binding IsDailyLogsEmpty}"
                        BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeShape="RoundRectangle 18"
                        Padding="18">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Aucun écogeste pour cette date"
                               TextColor="{StaticResource TextWhite}"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Choisissez un autre jour dans le calendrier."
                               TextColor="{StaticResource TextGray}"
                               FontSize="12"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
