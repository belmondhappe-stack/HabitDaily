<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:constants="clr-namespace:HabitDaily.Constants"
             xmlns:models="clr-namespace:HabitDaily.Models"
             xmlns:viewModels="clr-namespace:HabitDaily.ViewModels"
             x:Class="HabitDaily.Views.DashboardPage"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Accueil">

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">
        
        <!-- En-tête fixe -->
        <VerticalStackLayout Grid.Row="0" Spacing="15">
            <!-- Bienvenue & Badge -->
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Bonjour," TextColor="{StaticResource TextGray}" FontSize="14" />
                    <Label Text="{Binding CurrentUser.FullName, TargetNullValue='Éco-citoyen(ne)'}"
                           TextColor="{StaticResource TextWhite}"
                           FontSize="22"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
                
                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <!-- Bouton Ajouter une habitude -->
                    <Button Text="{x:Static constants:IconFont.Plus}"
                            FontFamily="MaterialIcons"
                            TextColor="{StaticResource BackgroundDark}"
                            BackgroundColor="{StaticResource PrimaryGreen}"
                            FontSize="18"
                            CornerRadius="18"
                            WidthRequest="36"
                            HeightRequest="36"
                            Command="{Binding AddHabitCommand}"
                            VerticalOptions="Center" />

                    <!-- Badge Niveau -->
                    <Border BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource PrimaryGreen}"
                            StrokeShape="RoundRectangle 20"
                            Padding="12,6"
                            VerticalOptions="Center">
                        <Label Text="{Binding CurrentUser.LevelBadge, TargetNullValue='Niv. 1'}"
                               TextColor="{StaticResource PrimaryGreen}"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- Carte Impact CO2 / Statistiques rapides -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="CO₂ Économisé" TextColor="{StaticResource TextGray}" FontSize="12" />
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding CurrentUser.TotalCo2Saved, StringFormat='{0:F1}'}" 
                                   TextColor="{StaticResource PrimaryGreen}" 
                                   FontSize="24" 
                                   FontAttributes="Bold" />
                            <Label Text="kg" TextColor="{StaticResource PrimaryGreen}" FontSize="16" VerticalOptions="End" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Série en cours" TextColor="{StaticResource TextGray}" FontSize="12" />
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding CurrentUser.CurrentStreak}" 
                                   TextColor="{StaticResource SecondaryBlue}" 
                                   FontSize="24" 
                                   FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="4" VerticalOptions="End">
                                <Label Text="jours" TextColor="{StaticResource SecondaryBlue}" FontSize="14" />
                                <Label Text="{x:Static constants:IconFont.Fire}"
                                       FontFamily="MaterialIcons"
                                       TextColor="{StaticResource SecondaryBlue}"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <HorizontalStackLayout Spacing="8">
                <Label Text="{x:Static constants:IconFont.Leaf}"
                       FontFamily="MaterialIcons"
                       TextColor="{StaticResource PrimaryGreen}"
                       FontSize="22"
                       VerticalOptions="Center" />
                <Label Text="Habitudes du jour"
                       TextColor="{StaticResource TextWhite}"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Liste des habitudes -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding TodayHabits}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Habit">
                        <Border BackgroundColor="{StaticResource CardBackground}"
                                Stroke="{StaticResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12"
                                Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="{Binding IconGlyph}"
                                       FontFamily="MaterialIcons"
                                       TextColor="{Binding IconColor}"
                                       FontSize="22"
                                       VerticalOptions="Center"
                                       Margin="0,0,12,0" />

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" TextColor="{StaticResource TextWhite}" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding Subtitle}" TextColor="{StaticResource TextGray}" FontSize="12" />
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="{x:Static constants:IconFont.Unchecked}"
                                        FontFamily="MaterialIcons"
                                        TextColor="{StaticResource TextMuted}"
                                        BackgroundColor="{StaticResource CardBackground}"
                                        CornerRadius="20"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Command="{Binding ToggleHabitCommand, Source={RelativeSource AncestorType={x:Type viewModels:DashboardViewModel}}}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                                                     Binding="{Binding IsCompletedToday}"
                                                     Value="True">
                                            <Setter Property="Text" Value="{x:Static constants:IconFont.Check}" />
                                            <Setter Property="TextColor" Value="{StaticResource BackgroundDark}" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryGreen}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>