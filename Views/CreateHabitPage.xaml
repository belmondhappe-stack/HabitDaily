<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:constants="clr-namespace:HabitDaily.Constants"
             xmlns:models="clr-namespace:HabitDaily.ViewModels"
             xmlns:viewModels="clr-namespace:HabitDaily.ViewModels"
             xmlns:controls="clr-namespace:HabitDaily.Views.Controls"
             x:Class="HabitDaily.Views.CreateHabitPage"
             x:DataType="viewModels:CreateHabitViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Nouvelle habitude">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="20"
          RowSpacing="12"
          HorizontalOptions="Center"
          MaximumWidthRequest="600">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Text="{x:Static constants:IconFont.ArrowBack}"
                    FontFamily="MaterialIcons"
                    FontSize="20"
                    TextColor="{StaticResource TextWhite}"
                    BackgroundColor="{StaticResource CardBackground}"
                    CornerRadius="22"
                    WidthRequest="44"
                    HeightRequest="44"
                    Command="{Binding CancelCommand}"
                    SemanticProperties.Description="Retourner à l'accueil" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="Créer une habitude"
                       TextColor="{StaticResource TextWhite}"
                       FontSize="22"
                       FontAttributes="Bold" />
                <Label Text="Construisez une routine qui vous ressemble."
                       TextColor="{StaticResource TextGray}"
                       FontSize="12" />
            </VerticalStackLayout>
            <Button Grid.Column="2"
                    Text="{x:Static constants:IconFont.Notifications}"
                    FontFamily="MaterialIcons"
                    FontSize="20"
                    TextColor="{StaticResource TextWhite}"
                    BackgroundColor="{StaticResource CardRaised}"
                    BorderColor="{StaticResource BorderColor}"
                    BorderWidth="1"
                    CornerRadius="22"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    Clicked="OnNotificationsClicked"
                    SemanticProperties.Description="Notifications" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="0,4,0,12">
                <Border BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="52"
                                HeightRequest="52"
                                BackgroundColor="{Binding SelectedColor.Color}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                VerticalOptions="Center">
                            <Label Text="{Binding SelectedIcon.Glyph}"
                                   FontFamily="MaterialIcons"
                                   FontSize="28"
                                   TextColor="{StaticResource BackgroundDark}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                            <Label Text="{Binding Title, TargetNullValue='Votre nouvelle habitude'}"
                                   TextColor="{StaticResource TextWhite}"
                                   FontSize="16"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding SelectedFrequency}"
                                   TextColor="{StaticResource TextGray}"
                                   FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Nom de l'habitude"
                           TextColor="{StaticResource TextWhite}"
                           FontSize="14"
                           FontAttributes="Bold" />
                    <Border BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,2">
                        <Entry AutomationId="HabitTitleEntry"
                               Placeholder="Ex. Lire 10 minutes"
                               PlaceholderColor="{StaticResource TextMuted}"
                               TextColor="{StaticResource TextWhite}"
                               MaxLength="60"
                               ReturnType="Done"
                               Text="{Binding Title, Mode=TwoWay}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Couleur de l’habitude"
                               TextColor="{StaticResource TextWhite}"
                               FontSize="14"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding SelectedColorValue}"
                               TextColor="{StaticResource TextGray}"
                               FontSize="12"
                               VerticalOptions="Center" />
                    </Grid>

                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding AvailableColors}"
                                           Spacing="14">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:HabitColorOption">
                                <Border WidthRequest="40"
                                        HeightRequest="40"
                                        Stroke="{StaticResource TextWhite}"
                                        StrokeThickness="1"
                                        StrokeShape="Ellipse"
                                        SemanticProperties.Description="{Binding Name}">
                                    <Grid>
                                        <Ellipse Fill="{Binding Color}" />
                                        <Label Text="{x:Static constants:IconFont.Check}"
                                               FontFamily="MaterialIcons"
                                               FontSize="18"
                                               TextColor="{StaticResource BackgroundDark}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               IsVisible="{Binding IsSelected}" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectColorCommand, Source={RelativeSource AncestorType={x:Type viewModels:CreateHabitViewModel}}}"
                                            CommandParameter="{Binding HexValue}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <Border Stroke="{StaticResource BorderColor}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Padding="2">
                        <controls:ColorPickerControl Hue="0"
                                                      SelectedColor="{Binding PickerColor, Mode=TwoWay}" />
                    </Border>
                    <Label Text="Touchez ou faites glisser pour choisir la teinte, la saturation et la luminosité."
                           TextColor="{StaticResource TextGray}"
                           FontSize="11" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Icône de l’habitude"
                           TextColor="{StaticResource TextWhite}"
                           FontSize="14"
                           FontAttributes="Bold" />
                    <Border BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="{Binding SelectedColor.Color}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="{Binding SelectedIcon.Glyph}"
                                       FontFamily="MaterialIcons"
                                       FontSize="22"
                                       TextColor="{StaticResource BackgroundDark}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="{Binding SelectedIcon.Label}"
                                       TextColor="{StaticResource TextWhite}"
                                       FontAttributes="Bold"
                                       FontSize="13" />
                                <Label Text="{Binding SelectedIcon.Category}"
                                       TextColor="{StaticResource TextGray}"
                                       FontSize="11" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="Parcourir"
                                    TextColor="{StaticResource PrimaryGreen}"
                                    BackgroundColor="{StaticResource BackgroundDark}"
                                    CornerRadius="10"
                                    Command="{Binding ChooseIconCommand}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Catégorie"
                           TextColor="{StaticResource TextWhite}"
                           FontSize="14"
                           FontAttributes="Bold" />
                    <Border BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeShape="RoundRectangle 12"
                            Padding="10,2">
                        <Picker AutomationId="HabitCategoryPicker"
                                Title="Choisir une catégorie"
                                TitleColor="{StaticResource TextMuted}"
                                TextColor="{StaticResource TextWhite}"
                                ItemsSource="{Binding Categories}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
                    </Border>
                    <Label Text="{Binding DefaultCo2, StringFormat='Valeur CO₂ par validation : {0:F1} kg'}"
                           TextColor="{StaticResource TextGray}"
                           FontSize="11" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Fréquence"
                           TextColor="{StaticResource TextWhite}"
                           FontSize="14"
                           FontAttributes="Bold" />
                    <Border BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeShape="RoundRectangle 12"
                            Padding="10,2">
                        <Picker AutomationId="HabitFrequencyPicker"
                                Title="Choisir une fréquence"
                                TitleColor="{StaticResource TextMuted}"
                                TextColor="{StaticResource TextWhite}"
                                BackgroundColor="{StaticResource CardBackground}"
                                ItemsSource="{Binding Frequencies}"
                                SelectedItem="{Binding SelectedFrequency, Mode=TwoWay}" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2"
                AutomationId="SaveHabitButton"
                Text="{Binding SaveButtonText}"
                TextColor="{StaticResource BackgroundDark}"
                BackgroundColor="{StaticResource PrimaryGreen}"
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="12"
                HeightRequest="52"
                Command="{Binding SaveCommand}" />
    </Grid>
</ContentPage>
